<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
	version="3.0">
	<display-name>ProyectoPizzaAmericana</display-name>
	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
		<welcome-file>index.htm</welcome-file>
		<welcome-file>index.jsp</welcome-file>
		<welcome-file>default.html</welcome-file>
		<welcome-file>default.htm</welcome-file>
		<welcome-file>default.jsp</welcome-file>
	</welcome-file-list>


	<filter>
		<filter-name>CorsFilter</filter-name>
		<filter-class>capaSeguridad.filtro.CorsFilter</filter-class>
	</filter>

	<filter-mapping>
		<filter-name>CorsFilter</filter-name>
		<url-pattern>/ObtenerVacantes</url-pattern>
		<url-pattern>/ObtenerVacanteDetalle</url-pattern>
		<url-pattern>/ObtenerVacanteID</url-pattern>
		<url-pattern>/InsertarCandidato</url-pattern>
		<url-pattern>/Fidelizacion</url-pattern>
		<url-pattern>/InsertarPqrsWeb</url-pattern>
		<url-pattern>/EncuestaServicioWb</url-pattern>
		<url-pattern>/VdclienteWb</url-pattern>
		<url-pattern>/PartidoWb</url-pattern>
		<url-pattern>/PronosticoWb</url-pattern>
	</filter-mapping>


	<filter>
		<filter-name>JwtAuthFilter</filter-name>
		<filter-class>capaSeguridad.filtro.JwtAuthFilter</filter-class>
	</filter>

	<filter-mapping>
		<filter-name>JwtAuthFilter</filter-name>
		<url-pattern>/ObtenerVacantes</url-pattern>
		<url-pattern>/ObtenerVacanteDetalle</url-pattern>
		<url-pattern>/ObtenerVacanteID</url-pattern>
		<url-pattern>/InsertarCandidato</url-pattern>
		<url-pattern>/Fidelizacion</url-pattern>
		<url-pattern>/InsertarPqrsWeb</url-pattern>
		<url-pattern>/EncuestaServicioWb</url-pattern>
		<url-pattern>/VdclienteWb</url-pattern>
		<url-pattern>/PartidoWb</url-pattern>
		<url-pattern>/PronosticoWb</url-pattern>
	</filter-mapping>

	<!--
		Tiempo de vida de las sesiones HTTP, en minutos.

		Antes no estaba definido, asi que Tomcat aplicaba su valor por defecto de 30
		minutos. Los servicios de esta aplicacion son sin estado y los clientes (POS,
		tablet) abren un cliente HTTP nuevo por llamada, sin reenviar el JSESSIONID.
		Resultado: cada llamada creaba una sesion nueva que vivia media hora sin que
		nadie la usara jamas, y la memoria del Tomcat crecia en proporcion directa al
		trafico.

		Con 2 minutos, esas sesiones se recogen casi de inmediato.

		Esto NO acorta la sesion de los usuarios logueados. GetIngresarAplicacion, que
		es el servlet de ingreso, fija su propio tiempo por codigo con
		sesion.setMaxInactiveInterval(60*20), es decir 20 minutos, y ese valor manda
		sobre el de aqui. Lo que se define en este archivo es solo el valor por defecto,
		que es el que aplica a las sesiones basura de los servicios sin estado.

		Los 10 servicios que si usan la sesion la consumen dentro de la misma peticion o
		dependen de la sesion de login: CRUDOfertaCliente, CRUDTiempoPedido,
		EliminarPedidoSinConfirmar, FinalizarPedidoReenvio, GetIngresarAplicacion,
		GetUsarCodigoPromocional, InsertarClienteEncabezadoPedido, InsertarEncabezadoPedido,
		SalirUsuarioAplicacion y ValidarUsuarioAplicacion.
	-->
	<session-config>
		<session-timeout>2</session-timeout>
	</session-config>

</web-app>